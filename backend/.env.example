# ---- LLM (single, configurable provider) ----
# LLM_PROVIDER: "google" for Gemini, or "mock" for offline/deterministic runs (no key needed)
LLM_PROVIDER=google
MODEL_NAME=gemini-1.5-flash
# Required only when LLM_PROVIDER=google. NEVER commit your real key.
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_MAX_RETRIES=1
LLM_REQUEST_TIMEOUT_S=60

# ---- Research knobs (configurable) ----
ALIGNMENT_THRESHOLD=0.75
MAX_DEBATE_ROUNDS=3
MAX_IDEAS=3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Persistence ----
DATABASE_URL=sqlite:///./hackathon_planner.db
CHECKPOINT_DB_PATH=./checkpoints.sqlite
